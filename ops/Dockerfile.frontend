# Build
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Run
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
# Make the frontend call same-origin /api
ENV NEXT_PUBLIC_API_BASE_URL=/api
EXPOSE 3000
CMD ["npm","run","start","--","-p","3000"]
